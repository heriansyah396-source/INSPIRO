rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Schools Binaan Collection
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(schoolId);
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(teacherId);
    }

    // Supervisions Collection
    match /supervisions/{supervisionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(supervisionId);
    }
  }
}
