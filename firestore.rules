rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection Healthcheck
    match /test/{docId} {
      allow read, write: if true;
    }

    // Managed Accounts (Pengawas & Kepala Sekolah Binaan Multi-Device Sync)
    match /managed_accounts/{accountId} {
      allow read: if true;
      allow write: if isValidId(accountId);
    }

    // App Settings (School profile, supervisor credentials)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Teachers Directory
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isValidId(teacherId);
    }

    // Academic Supervision Records
    match /supervisions/{supervisionId} {
      allow read: if true;
      allow write: if isValidId(supervisionId);
    }

    // PM Management Reports (Praktik Pedagogis)
    match /pm_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    // Users Collection (Firebase Auth Profiles)
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Schools Binaan Collection
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // Default deny catch-all for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

